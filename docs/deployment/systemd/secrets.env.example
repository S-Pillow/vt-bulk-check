# secrets.env.example
# TEMPLATE — do not commit a populated version of this file.
# This file shows the required format and variable names only.
#
# IMPORTANT:
#   - This example file is safe to commit.
#   - The real secrets.env file is NOT safe to commit and is excluded by .gitignore.
#   - Never place a real API key or credential in this file.
#   - Never commit any file that contains a real API key.
#
# On the production host:
#   sudo mkdir -p /etc/dns-tool
#   sudo cp secrets.env.example /etc/dns-tool/secrets.env
#   sudo nano /etc/dns-tool/secrets.env   # Replace placeholder with real value
#   sudo chown root:www-data /etc/dns-tool/secrets.env
#   sudo chmod 640 /etc/dns-tool/secrets.env
#
# Retrieve the real API key from your organization's secure credential
# store. Do not source it from any file in this repository.
#
# Format: KEY=VALUE
#   No quotes around the value.
#   No "export" keyword.
#   No shell variable syntax.
#   One variable per line.

VT_API_KEY=replace_with_real_key
